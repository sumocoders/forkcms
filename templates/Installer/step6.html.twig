{% extends 'Installer/base.html.twig' %}
{% import 'Installer/navigation.html.twig' as macro %}

{% block navigation %}
  {{ macro.navigation('step-6') }}
{% endblock %}

{% block content %}

  <div class="row fork-module-content">
    <div class="col-md-6 offset-md-3">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            Installation complete
          </h2>
        </div>
        <div class="card-body">
          <p>Fork CMS is installed! You can now log in using:</p>
          <table class="table table-striped">
            <tr>
              <th>Your e-mail</th>
              <td>{{ data.email }}</td>
            </tr>
            <tr>
              <th>Your password</th>
              <td>
                <span id="plainPassword" style="display: none;">{{ data.password }}</span>
                <span id="fakePassword">••••••••••••</span>
                <input type="checkbox" id="showPassword" name="showPassword" />
                <label for="showPassword">show password</label>
              </td>
            </tr>
          </table>
        </div>
        <div class="card-footer">
          <div class="btn-toolbar">
            <div class="btn-group float-end" role="group">
              <a class="btn btn-secondary" href="/" target="_blank" rel="noopener noreferrer">View your new website</a>
              <a class="btn btn-primary" href="../private" target="_blank" rel="noopener noreferrer">Log in to Fork CMS</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

{% endblock %}
