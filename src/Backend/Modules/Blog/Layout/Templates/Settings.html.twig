{% extends 'Layout/Templates/base.html.twig' %}
{% import "Layout/Templates/macros.html.twig" as macro %}

{% block actionbar %}

{% endblock %}

{% block content %}
  {% form settings %}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            {{ 'lbl.Pagination'|trans|ucfirst }}
          </h2>
        </div>
        <div class="card-body">
          <div class="mb-4">
            <label for="overviewNumberOfItems" class="form-label">{{ 'lbl.ItemsPerPage'|trans|ucfirst }}</label>
            {% form_field overview_number_of_items %} {% form_field_error overview_number_of_items %}
          </div>
          <div class="mb-4">
            <label for="recentArticlesFullNumberOfItems" class="form-label">{{ 'msg.NumItemsInRecentArticlesFull'|trans|ucfirst }}</label>
            {% form_field recent_articles_full_number_of_items %} {% form_field_error recent_articles_full_number_of_items %}
          </div>
          <div>
            <label for="recentArticlesListNumberOfItems" class="form-label">{{ 'msg.NumItemsInRecentArticlesList'|trans|ucfirst }}</label>
            {% form_field recent_articles_list_number_of_items %} {% form_field_error recent_articles_list_number_of_items %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            {{ 'lbl.Comments'|trans|ucfirst }}
          </h2>
        </div>
        <div class="card-body">
          <div>
            <ul class="list-unstyled">
              <li class="form-check">
                <label for="allowComments" class="form-check-label">
                  {% form_field allow_comments %} {{ 'lbl.AllowComments'|trans|ucfirst }}
                </label>
              </li>
              <li class="form-check">
                <label for="moderation" class="form-check-label">
                  {% form_field moderation %} {{ 'lbl.EnableModeration'|trans|ucfirst }}
                </label>
              </li>
            </ul>
            <p>{{ 'msg.FollowAllCommentsInRSS'|trans|format(commentsRSSURL)|raw }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% if isGod %}
    <div class="row fork-module-content">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">
              {{ 'lbl.Image'|trans|ucfirst }}
            </h2>
          </div>
          <div class="card-body">
            <div>
              <ul class="list-unstyled">
                <li class="form-check">
                  <label for="showImageForm" class="form-check-label">
                    {% form_field show_image_form %} {{ 'msg.ShowImageForm'|trans|ucfirst }}
                  </label>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            {{ 'lbl.Notifications'|trans|ucfirst }}
          </h2>
        </div>
        <div class="card-body">
          <div>
            <ul class="list-unstyled">
              <li class="form-check">
                <label for="notifyByEmailOnNewCommentToModerate" class="form-check-label">
                  {% form_field notify_by_email_on_new_comment_to_moderate %} {{ 'msg.NotifyByEmailOnNewCommentToModerate'|trans|ucfirst }}
                </label>
              </li>
              <li class="form-check">
                <label for="notifyByEmailOnNewComment" class="form-check-label">
                  {% form_field notify_by_email_on_new_comment %} {{ 'msg.NotifyByEmailOnNewComment'|trans|ucfirst }}
                </label>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            {{ 'lbl.RSSFeed'|trans|ucfirst }}
          </h2>
        </div>
        <div class="card-body">
          <div class="mb-4">
            <label for="rssTitle" class="form-label">
              {{ 'lbl.Title'|trans|ucfirst }}
              {{ macro.required }}
            </label>
            <p class="form-text">{{ 'msg.HelpRSSTitle'|trans|ucfirst }}</p>
            {% form_field rss_title %} {% form_field_error rss_title %}
          </div>
          <div class="mb-4">
            <label for="rssDescription" class="form-label">{{ 'lbl.Description'|trans|ucfirst }}</label>
            <p class="form-text">{{ 'msg.HelpRSSDescription'|trans|ucfirst }}</p>
            {% form_field rss_description %} {% form_field_error rss_description %}
          </div>
          <div>
            <p>{{ 'msg.HelpMeta'|trans|ucfirst }}:</p>
            <ul class="list-unstyled">
              <li class="form-check">
                <label for="rssMeta" class="form-check-label">{% form_field rss_meta %} {{ 'lbl.MetaInformation'|trans|ucfirst }}</label>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group float-end" role="group">
          {{ macro.buttonIcon('', 'floppy-disk', 'lbl.Save'|trans|ucfirst, 'btn-primary', {"type":"submit", "name":"save", "id":"save"}) }}
        </div>
      </div>
    </div>
  </div>
  {% endform %}
{% endblock %}
