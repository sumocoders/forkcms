{% extends 'Layout/Templates/base.html.twig' %}
{% import "Layout/Templates/macros.html.twig" as macro %}

{% block actionbar %}
  <div class="btn-toolbar float-end">
    <div class="btn-group" role="group">
      {% if detailURL %}
        {% set url = (detailURL ~ '/' ~ item.url) %}
        {% if item.revision_id %}
          {% set url = (url ~ '?revision=' ~ item.revision_id) %}
        {% endif %}

        {{ macro.buttonIcon(url, 'eye', 'lbl.View'|trans|ucfirst, 'btn-secondary', { "target":"_blank", "rel":"noopener noreferrer" }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block content %}
  {% form edit %}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="mb-4">
        <label for="title" class="form-label">{{ 'lbl.Title'|trans|ucfirst }} {{ macro.required }}</label>
        {% form_field title %} {% form_field_error title %}
        {% if detailURL %}
          <a class="site-url" href="{{ detailURL }}/{{ item.url }}">{{ detailURL }}/<span id="generatedUrl">{{ item.url }}</span></a>
        {% endif %}
        {% if not detailURL %}
          <p class="alert alert-warning alert-xs">
            {{ macro.icon('exclamation-triangle') }}{{ 'err.NoModuleLinked'|trans|ucfirst }}</p>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div>
        <ul class="nav nav-tabs nav-tabs-flex" role="tablist">
          <li role="presentation" class="nav-item me-auto">
            <a class="nav-link active" href="#tabContent" aria-controls="tabContent" role="tab" data-bs-toggle="tab">{{ 'lbl.Content'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabVersions" aria-controls="tabVersions" role="tab" data-bs-toggle="tab">{{ 'lbl.Versions'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabComments" aria-controls="tabComments" role="tab" data-bs-toggle="tab">{{ 'lbl.Comments'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabSEO" aria-controls="tabSEO" role="tab" data-bs-toggle="tab">{{ 'lbl.SEO'|trans|ucfirst }}</a>
          </li>
        </ul>
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane active" id="tabContent">
            <div class="row">
              <div class="col-md-8">
                <div class="card card-editor">
                  <div class="card-header">
                    <h2>
                      <label for="introduction">
                        {{ 'lbl.Summary'|trans|ucfirst }}
                        {{ macro.infoTooltip('msg.HelpSummary'|trans|ucfirst) }}
                      </label>
                    </h2>
                  </div>
                  <div class="card-body">
                    {% form_field introduction %}
                  </div>
                  {% if txtIntroductionError %}
                    <div class="card-footer">
                      {% form_field_error introduction %}
                    </div>
                  {% endif %}
                </div>
                {% if imageIsAllowed %}
                  <div class="card">
                    <div class="card-header">
                      <h2><label for="image">{{ 'lbl.Image'|trans|ucfirst }}</label></h2>
                    </div>
                    <div class="card-body">
                      <div class="row">
                        {% if item.image %}
                        <div class="col-lg-3">
                          <img src="{{ FRONTEND_FILES_URL }}/Blog/images/128x128/{{ item.image }}" class="img-thumbnail" width="200" height="200" alt="{{ 'lbl.Image'|trans|ucfirst }}" />
                        </div>
                        <div class="col-lg-9">
                          {% endif %}
                          {% form_field image %} {% form_field_error image %}
                          {% if item.image %}
                          <ul class="list-unstyled">
                            <li class="form-check">
                              <label for="deleteImage" class="form-check-label">{% form_field delete_image %} {{ 'lbl.Delete'|trans|ucfirst }}</label>
                              {% form_field_error delete_image %}
                            </li>
                          </ul>
                        </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
                <div class="card card-editor last">
                  <div class="card-header">
                    <h2>
                      <label for="text">
                        {{ 'lbl.MainContent'|trans|ucfirst }}
                        {{ macro.required }}
                      </label>
                    </h2>
                  </div>
                  <div class="card-body">
                    {% form_field text %}
                  </div>
                  {% if txtTextError %}
                    <div class="card-footer">
                      {% form_field_error text %}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="col-md-4">
                <div class="card">
                  <div class="card-header">
                    <h2>{{ 'lbl.Status'|trans|ucfirst }}</h2>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <ul class="list-unstyled">
                        {% for rbtn in hidden %}
                          <li class="form-check">
                            <label for="{{ rbtn.id }}">{{ rbtn.rbtHidden|raw }} {{ rbtn.label }}</label>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                    <div>
                      <label for="publishOnDate" class="form-label">{{ 'lbl.PublishOn'|trans|ucfirst }}</label>
                      {% form_field publish_on_date %} {% form_field_error publish_on_date %}
                      <label for="publishOnTime" class="form-label">{{ 'lbl.At'|trans }}</label>
                      {% form_field publish_on_time %} {% form_field_error publish_on_time %}
                    </div>
                  </div>
                </div>
                <div class="card">
                  <div class="card-header">
                    <h2>{{ 'lbl.MetaData'|trans|ucfirst }}</h2>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <label for="categoryId" class="form-label">{{ 'lbl.Category'|trans|ucfirst }}</label>
                      {% form_field category_id %} {% form_field_error category_id %}
                    </div>
                    <div class="mb-4">
                      <label for="userId" class="form-label">{{ 'lbl.Author'|trans|ucfirst }}</label>
                      {% form_field user_id %} {% form_field_error user_id %}
                    </div>
                    {% if isAllowedAction('Index', 'Tags') %}
                      <div>
                        <label for="tags" class="form-label">{{ 'lbl.Tags'|trans|ucfirst }}</label>
                        {% form_field tags %} {% form_field_error tags %}
                        <div class="form-text" id="tags-info">{{ 'msg.HelpTextTags'|trans }}</div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabVersions">
            <div class="row">
              <div class="col-md-12">
                {% if drafts %}
                  <div class="content-block">
                    <div class="content-title">
                      <h2>{{ 'lbl.Drafts'|trans|ucfirst }}
                        {{ macro.infoTooltip('msg.HelpDrafts'|trans|ucfirst) }}
                      </h2>
                    </div>
                    {{ drafts|raw }}
                  </div>
                {% endif %}
                <div class="content-block">
                  <div class="content-title">
                    <h2>
                      {{ 'lbl.PreviousVersions'|trans|ucfirst }}
                      {{ macro.infoTooltip('msg.HelpRevisions'|trans|ucfirst) }}
                    </h2>
                  </div>
                  {% if revisions %}
                    {{ revisions|raw }}
                  {% endif %}
                  {% if not revisions %}
                    <p>{{ 'msg.NoRevisions'|trans|ucfirst }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabComments">
            <div class="row">
              <div class="col-md-12">
                <div>
                  <ul class="list-unstyled">
                    <li class="form-check">
                      <label for="allowComments" class="form-check-label">{% form_field allow_comments %} {{ 'lbl.AllowComments'|trans|ucfirst }}</label>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabSEO">
            {% seo %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group float-start" role="group">
          {% if isAllowedAction('Delete') %}
            {{ macro.buttonIcon('', 'trash-can', 'lbl.Delete'|trans|ucfirst, 'btn-danger', {"id":"blog-delete", "data-bs-toggle":"modal", "data-bs-target":"#confirmDelete", "type":"button"} ) }}
          {% endif %}
          {{ macro.buttonIcon(geturl('Index'), 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary') }}
        </div>
        <div class="btn-group float-end" role="group">
          {{ macro.buttonIcon('', 'file', 'lbl.SaveDraft'|trans|ucfirst, 'btn-secondary', {"type":"submit", "name":"saveAsDraft"}) }}
          {{ macro.buttonIcon('', 'check', 'lbl.Publish'|trans|ucfirst, 'btn-primary', {"type":"submit", "name":"publish"}) }}
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="addCategoryDialog" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="addCategoryDialogTitle">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h4 class="modal-title" id="addCategoryDialogTitle">{{ 'lbl.AddCategory'|trans|ucfirst }}</h4>
        </div>
        <div class="modal-body">
          <div class="mb-4">
            <label for="categoryTitle" class="form-label">
              {{ 'lbl.Title'|trans|ucfirst }}
              {{ macro.required }}
            </label>
            <input type="text" name="categoryTitle" id="categoryTitle" class="form-control" maxlength="255" />
            <p class="text-danger" id="categoryTitleError" style="display: none;">{{ 'err.FieldIsRequired'|trans|ucfirst }}</p>
          </div>
        </div>
        <div class="modal-footer">
          {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary', {"data-bs-dismiss":"modal" }) }}
          {{ macro.buttonIcon('', 'plus-square', 'lbl.AddCategory'|trans|ucfirst, 'btn-primary', {"id":"addCategorySubmit", "type":"button"}) }}
        </div>
      </div>
    </div>
  </div>
  {% endform %}

  {% if isAllowedAction('Delete') %}
    {{ form_start(deleteForm) }}
    {{ form_row(deleteForm._token) }}
    {{ form_row(deleteForm.id) }}
    {{ form_row(deleteForm.categoryId) }}
    <div class="modal fade" id="confirmDelete" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="confirmDeleteTitle">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="confirmDeleteTitle">{{ 'lbl.Delete'|trans|ucfirst }}</h4>
          </div>
          <div class="modal-body">
            <p>{{ 'msg.ConfirmDelete'|trans|format(item.title|e)|raw }}</p>
          </div>
          <div class="modal-footer">
            {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary', {"data-bs-dismiss":"modal"}) }}
            {{ macro.buttonIcon('', 'trash', 'lbl.Delete'|trans|ucfirst, 'btn-danger', {"type":"submit"}) }}
          </div>
        </div>
      </div>
    </div>
    {{ form_end(deleteForm) }}
  {% endif %}
{% endblock %}
