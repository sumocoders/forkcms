{% extends 'Layout/Templates/base.html.twig' %}
{% import "Layout/Templates/macros.html.twig" as macro %}

{% block actionbar %}

{% endblock %}

{% block content %}

  {% form add %}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div class="mb-4">
        <label for="title" class="form-label">{{ 'lbl.Title'|trans|ucfirst }} {{ macro.required }}</label>
        {% form_field title %} {% form_field_error title %}
        {% if detailURL %}
          <a class="site-url" href="{{ detailURL }}">{{ detailURL }}/<span id="generatedUrl"></span></a>
        {% endif %}
        {% if not detailURL %}
          <p class="text-warning">{{ macro.icon('warning') }} {{ 'err.NoModuleLinked'|trans|ucfirst }}</p>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div>
        <ul class="nav nav-tabs nav-tabs-flex" role="tablist">
          <li role="presentation" class="nav-item me-auto">
            <a class="nav-link active" href="#tabContent" aria-controls="tabContent" role="tab" data-bs-toggle="tab">{{ 'lbl.Content'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabComments" aria-controls="tabComments" role="tab" data-bs-toggle="tab">{{ 'lbl.Comments'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabSEO" aria-controls="tabSEO" role="tab" data-bs-toggle="tab">{{ 'lbl.SEO'|trans|ucfirst }}</a>
          </li>
        </ul>
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane active" id="tabContent">
            <div class="row">
              <div class="col-md-8">
                <div class="card card-editor">
                  <div class="card-header">
                    <h2>
                      <label for="introduction">
                        {{ 'lbl.Summary'|trans|ucfirst }}
                        {{ macro.infoTooltip('msg.HelpSummary'|trans|ucfirst) }}
                      </label>
                    </h2>
                  </div>
                  <div class="card-body">
                    {% form_field introduction %}
                  </div>
                  {% if txtIntroductionError %}
                    <div class="card-footer">
                      {% form_field_error introduction %}
                    </div>
                  {% endif %}
                </div>
                {% if imageIsAllowed %}
                  <div class="card">
                    <div class="card-header">
                      <h2><label for="image">{{ 'lbl.Image'|trans|ucfirst }}</label></h2>
                    </div>
                    <div class="card-body">
                      {% form_field image %} {% form_field_error image %}
                    </div>
                  </div>
                {% endif %}
                <div class="card card-editor last">
                  <div class="card-header">
                    <h2>
                      <label for="text">
                        {{ 'lbl.MainContent'|trans|ucfirst }}
                        {{ macro.required }}
                      </label>
                    </h2>
                  </div>
                  <div class="card-body">
                    {% form_field text %}
                  </div>
                  {% if txtTextError %}
                    <div class="card-footer">
                      {% form_field_error text %}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="col-md-4">
                <div class="card">
                  <div class="card-header">
                    <h2>{{ 'lbl.Status'|trans|ucfirst }}</h2>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <ul class="list-unstyled">
                        {% for _itr_4 in hidden %}
                          <li class="form-check">
                            <label for="{{ _itr_4.id }}">{{ _itr_4.rbtHidden|raw }} {{ _itr_4.label }}</label>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                    <div>
                      <label for="publishOnDate" class="form-label">{{ 'lbl.PublishOn'|trans|ucfirst }}</label>
                      {% form_field publish_on_date %} {% form_field_error publish_on_date %}
                      <label for="publishOnTime" class="form-label">{{ 'lbl.At'|trans }}</label>
                      {% form_field publish_on_time %} {% form_field_error publish_on_time %}
                    </div>
                  </div>
                </div>
                <div class="card">
                  <div class="card-header">
                    <h2>{{ 'lbl.MetaData'|trans|ucfirst }}</h2>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      <label for="categoryId" class="form-label">{{ 'lbl.Category'|trans|ucfirst }}</label>
                      {% form_field category_id %} {% form_field_error category_id %}
                    </div>
                    <div class="mb-4">
                      <label for="userId" class="form-label">{{ 'lbl.Author'|trans|ucfirst }}</label>
                      {% form_field user_id %} {% form_field_error user_id %}
                    </div>
                    {% if isAllowedAction('Index', 'Tags') %}
                      <div>
                        <label for="tags" class="form-label">{{ 'lbl.Tags'|trans|ucfirst }}</label>
                        {% form_field tags %} {% form_field_error tags %}
                        <div class="form-text" id="tags-info">{{ 'msg.HelpTextTags'|trans }}</div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabComments">
            <div class="row">
              <div class="col-md-12">
                <div>
                  <ul class="list-unstyled">
                    <li class="form-check">
                      <label for="allowComments" class="form-check-label">{% form_field allow_comments %} {{ 'lbl.AllowComments'|trans|ucfirst }}</label>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabSEO">
            {% seo %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-module-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group" role="group">
          {{ macro.buttonIcon(geturl('Index'), 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary') }}
        </div>
        <div class="btn-group float-end" role="group">
          {{ macro.buttonIcon('', 'file', 'lbl.SaveDraft'|trans|ucfirst, 'btn-secondary', {"type":"submit", "name":"saveAsDraft"}) }}
          {{ macro.buttonIcon('', 'plus-square', 'lbl.Publish'|trans|ucfirst, 'btn-primary', {"type":"submit", "name":"publish"}) }}
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="addCategoryDialog" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="addCategoryDialogTitle">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h4 class="modal-title" id="addCategoryDialogTitle">{{ 'lbl.AddCategory'|trans|ucfirst }}</h4>
        </div>
        <div class="modal-body">
          <div class="mb-4">
            <label for="categoryTitle" class="form-label">
              {{ 'lbl.Title'|trans|ucfirst }}
              {{ macro.required }}
            </label>
            <input type="text" name="categoryTitle" id="categoryTitle" class="form-control" maxlength="255" />
            <p class="text-danger" id="categoryTitleError" style="display: none;">{{ 'err.FieldIsRequired'|trans|ucfirst }}</p>
          </div>
        </div>
        <div class="modal-footer">
          {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary', {"data-bs-dismiss":"modal"}) }}
          {{ macro.buttonIcon('', 'plus-square', 'lbl.AddCategory'|trans|ucfirst, 'btn-primary', {"id":"addCategorySubmit", "type":"button"}) }}
        </div>
      </div>
    </div>
  </div>
  {% endform %}

{% endblock %}
