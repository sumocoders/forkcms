{% extends 'Layout/Templates/base.html.twig' %}
{% import "Layout/Templates/macros.html.twig" as macro %}

{% block content %}
  {{ form_start(form) }}
  <div class="row fork-module-content">
    <div class="col-md-12">
      {{ form_row(form.title, {'attr': {'class': 'form-control title'}}) }}
    </div>
  </div>

  <div class="row fork-module-content">
    <div class="col-md-12">
      <div>
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <a class="nav-link active" href="#tabContent" aria-controls="tabContent" role="tab" data-bs-toggle="tab">{{ 'lbl.Content'|trans|ucfirst }}</a>
          </li>
        </ul>

        <div class="tab-content">

          <div role="tabpanel" class="tab-pane active" id="tabContent">
            <div class="row">
              <div class="col-md-8">
                {% if form.action %}
                <div id="publishOptions" class="card">
                  <div class="card-header">
                    <h2 class="card-title">
                      {{ 'lbl.WidgetView'|trans|ucfirst }}{{ macro.required }}
                      {{ macro.infoTooltip('msg.WidgetViewsHelp'|trans|ucfirst) }}
                    </h2>
                  </div>
                  <div class="card-body">
                    <div>
                      {{ form_widget(form.action) }}
                      {{ form_errors(form.action) }}
                    </div>
                  </div>
                </div>
                {% endif %}

                {# Including the MediaLibrary MediaGroup Helper #}
                {{ form_widget(form.mediaGroup) }}

                {{ form_row(form.text) }}
              </div>
              <div class="col-md-4">
                <div class="card">
                  <div class="card-header">
                    <h2 class="card-title">{{ form_label(form.status) }}</h2>
                  </div>
                  <div class="card-body">
                    <div class="mb-4">
                      {{ form_widget(form.status) }}
                      {{ form_errors(form.status) }}
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="row fork-module-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group float-start" role="group">
          {% if isAllowedAction('MediaGalleryDelete') %}
            {{ macro.buttonIcon('', 'trash-can', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "id":"blog-delete", "data-bs-toggle":"modal", "data-bs-target":"#confirmDelete" } ) }}
          {% endif %}
          {{ macro.buttonIcon(geturl('MediaGalleryIndex'), 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary') }}
        </div>
        <div class="btn-group float-end" role="group">
          {{ macro.buttonIcon('', 'plus-square', 'lbl.Save'|trans|ucfirst, 'btn-primary', { "type":"submit", "id":"addButton", "name":"add"} ) }}
        </div>
      </div>
    </div>
  </div>
  {{ form_end(form) }}

  {% if isAllowedAction('MediaGalleryDelete') %}
    {{ form_start(deleteForm) }}
    {{ form_row(deleteForm._token) }}
    {{ form_row(deleteForm.id) }}
    <div class="modal fade" id="confirmDelete" role="dialog" tabindex="-1" aria-hidden="true" aria-labelledby="confirmDeleteTitle">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="confirmDeleteTitle">{{ 'lbl.Delete'|trans|ucfirst }}</h4>
          </div>
          <div class="modal-body">
            <p>{{ 'msg.ConfirmDelete'|trans|format(mediaGallery.title|e)|raw }}</p>
          </div>
          <div class="modal-footer">
            {{ macro.buttonIcon('', 'times', 'lbl.Cancel'|trans|ucfirst, 'btn-secondary', { "data-bs-dismiss":"modal", "type":"button" } ) }}
            {{ macro.buttonIcon('', 'trash', 'lbl.Delete'|trans|ucfirst, 'btn-danger', { "type":"submit" } ) }}
          </div>
        </div>
      </div>
    </div>
    {{ form_end(deleteForm) }}
  {% endif %}
{% endblock %}
