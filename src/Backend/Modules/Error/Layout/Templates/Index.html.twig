{% extends 'Layout/Templates/empty.html.twig' %}

{% block content %}
<body id="{{ bodyID }}" class="{{ bodyClass }}">
<div class="text-center border-bottom pb-2 mt-5 mb-4">
  <h1>{{ SITE_TITLE }}</h1>
</div>
<div class="container">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            {{ 'lbl.Error'|trans|ucfirst }}
          </h2>
        </div>
        <div class="card-body">
          <p>{{ message }}</p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
