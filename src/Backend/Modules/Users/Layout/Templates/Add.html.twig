{% extends 'Layout/Templates/base.html.twig' %}
{% import 'Layout/Templates/macros.html.twig' as macro %}

{% block actionbar %}

{% endblock %}

{% block content %}
  {% form add %}
  <div class="row fork-module-content">
    <div class="col-md-12">
      <div>
        <ul class="nav nav-tabs" role="tablist">
          <li role="presentation" class="nav-item">
            <a class="nav-link active" href="#tabProfile" aria-controls="tabProfile" role="tab" data-bs-toggle="tab">{{ 'lbl.Profile'|trans|ucfirst }}</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#tabPermissions" aria-controls="tabPermissions" role="tab" data-bs-toggle="tab">{{ 'lbl.Permissions'|trans|ucfirst }}</a>
          </li>
        </ul>
        <div class="tab-content">
          <div role="tabpanel" class="tab-pane active" id="tabProfile">
            <div class="row">
              <div class="col-md-12">
                <div class="mb-4">
                  <label for="email" class="form-label">
                    {{ 'lbl.Email'|trans|ucfirst }}
                    {{ macro.required }}
                  </label>
                  {% form_field email %} {% form_field_error email %}
                </div>
                <div>
                  <label for="password" class="form-label">
                    {{ 'lbl.Password'|trans|ucfirst }}
                    {{ macro.required }}
                  </label>
                  <table id="passwordStrengthMeter" class="passwordStrength" data-id="password">
                    <tr>
                      <td class="strength" id="passwordStrength">
                        <p class="strength none">
                          <span class="badge text-bg-secondary">None</span>
                        </p>
                        <p class="strength weak">
                          <span class="badge text-bg-danger">Weak</span>
                        </p>
                        <p class="strength average">
                          <span class="badge text-bg-warning">Average</span>
                        </p>
                        <p class="strength strong">
                          <span class="badge text-bg-success">Strong</span>
                        </p>
                      </td>
                      <td>
                        <p class="form-text">&nbsp;{{ 'msg.HelpStrongPassword'|trans }}</p>
                      </td>
                    </tr>
                  </table>
                  <div class="row">
                    <div class="col-md-6">
                      <div class="mb-4">
                        <div class="input-group">
                          {% form_field password %}
                        </div>
                        {% form_field_error password %}
                      </div>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-md-6">
                      <div class="mb-4">
                        <label for="confirmPassword" class="form-label">
                          {{ 'lbl.ConfirmPassword'|trans|ucfirst }}
                          {{ macro.required }}
                        </label>
                        {% form_field confirm_password %} {% form_field_error confirm_password %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <fieldset>
                  <legend>
                    {{ 'lbl.PersonalInformation'|trans|ucfirst }}
                  </legend>
                  <div class="mb-4">
                    <label for="name" class="form-label">
                      {{ 'lbl.Name'|trans|ucfirst }}
                      {{ macro.required }}
                    </label>
                    {% form_field name %} {% form_field_error name %}
                  </div>
                  <div class="mb-4">
                    <label for="surname" class="form-label">
                      {{ 'lbl.Surname'|trans|ucfirst }}
                      {{ macro.required }}
                    </label>
                    {% form_field surname %} {% form_field_error surname %}
                  </div>
                  <div class="mb-4">
                    <label for="nickname" class="form-label">
                      {{ 'lbl.Nickname'|trans|ucfirst }}
                      {{ macro.required }}
                    </label>
                    <p class="form-text">{{ 'msg.HelpNickname'|trans }}</p>
                    {% form_field nickname %} {% form_field_error nickname %}
                  </div>
                  <div class="mb-4">
                    <label for="avatar" class="form-label">{{ 'lbl.Avatar'|trans|ucfirst }}</label>
                    <p class="form-text">{{ 'msg.HelpAvatar'|trans }}</p>
                    {% form_field avatar %} {% form_field_error avatar %}
                  </div>
                </fieldset>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <fieldset>
                  <legend>{{ 'lbl.InterfacePreferences'|trans|ucfirst }}</legend>
                  <div class="mb-4">
                    <label for="interfaceLanguage" class="form-label">{{ 'lbl.Language'|trans|ucfirst }}</label>
                    {% form_field interface_language %} {% form_field_error interface_language %}
                  </div>
                  <div class="mb-4">
                    <label for="preferredEditor" class="form-label">{{ 'lbl.PreferredEditor'|trans|ucfirst }}</label>
                    {% form_field preferred_editor %} {% form_field_error preferred_editor %}
                  </div>
                  <div class="mb-4">
                    <label for="numberFormat" class="form-label">{{ 'lbl.NumberFormat'|trans|ucfirst }}</label>
                    {% form_field number_format %} {% form_field_error number_format %}
                  </div>
                </fieldset>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <fieldset class="last">
                  <legend>{{ 'lbl.CSV'|trans|ucfirst }}</legend>
                  <div class="mb-4">
                    <label for="csvSplitChar'act.r">{{ 'lbl.SplitCharacter'|trans|ucfirst }}</label>
                    {% form_field csv_split_character %} {% form_field_error csv_split_character %}
                  </div>
                  <div>
                    <label for="csvLineEnding" class="form-label">{{ 'lbl.LineEnding'|trans|ucfirst }}</label>
                    {% form_field csv_line_ending %} {% form_field_error csv_line_ending %}
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
          <div role="tabpanel" class="tab-pane" id="tabPermissions">
            <div class="row">
              <div class="col-md-12">
                <div class="mb-4">
                  <ul class="list-unstyled">
                    <li class="form-check">
                      <label for="active" class="form-check-label">{% form_field active %} {% form_field_error active %} {{ 'msg.HelpActive'|trans }}</label>
                    </li>
                  </ul>
                </div>
                <div class="mb-4">
                  <p>{{ 'lbl.Groups'|trans|ucfirst }}</p>
                  <ul id="groupList" class="list-unstyled">
                    {% for group in groups %}
                      <li class="form-check">
                        <label for="{{ group.id }}">{{ group.chkGroups|raw }} {{ group.label }}</label>
                      </li>
                    {% endfor %}
                  </ul>
                  {% form_field_error groups %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row fork-page-actions">
    <div class="col-md-12">
      <div class="btn-toolbar">
        <div class="btn-group float-end" role="group">
          {{ macro.buttonIcon('', 'plus-square', 'lbl.Add'|trans|ucfirst, 'btn-primary', {id: 'addButton', type: 'submit', name: 'add'}) }}
        </div>
      </div>
    </div>
  </div>
  {% endform %}

{% endblock %}
