{% extends 'Layout/Templates/base.html.twig' %}
{% import "Layout/Templates/macros.html.twig" as macro %}

{% block actionbar %}

{% endblock %}

{% block content %}
  {% form add %}
    <div class="row fork-module-content">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">{{ 'lbl.Profile'|trans|ucfirst }}</h2>
          </div>
          <div class="card-body">
            <div class="mb-4">
              <label for="email" class="form-label">
                {{ 'lbl.Email'|trans|ucfirst }}
                {{ macro.required }}
              </label>
              {% form_field email %} {% form_field_error email %}
            </div>
            <div class="mb-4">
              <label for="displayName" class="form-label">
                {{ 'lbl.DisplayName'|trans|ucfirst }}
                {{ macro.required }}
              </label>
              {% form_field display_name %} {% form_field_error display_name %}
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">
                {{ 'lbl.Password'|trans|ucfirst }}
                {% if not notifyProfile %}
                  {{ macro.required }}{% endif %}
              </label>
              {% form_field password %} {% form_field_error password %}
              {% if notifyProfile %}<span class="helpTxt">{{ 'msg.AutoGeneratedPasswordIfEmpty'|trans }}</span>{% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="row fork-module-content">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">{{ 'lbl.Settings'|trans|ucfirst }}</h2>
          </div>
          <div class="card-body">
            <div class="mb-4">
              <label for="firstName" class="form-label">{{ 'lbl.FirstName'|trans|ucfirst }}</label>
              {% form_field first_name %} {% form_field_error first_name %}
            </div>
            <div class="mb-4">
              <label for="lastName" class="form-label">{{ 'lbl.LastName'|trans|ucfirst }}</label>
              {% form_field last_name %} {% form_field_error last_name %}
            </div>
            <div class="mb-4">
              <label for="gender" class="form-label">{{ 'lbl.Gender'|trans|ucfirst }}</label>
              {% form_field gender %} {% form_field_error gender %}
            </div>
            <div class="mb-4">
              <label for="day" class="form-label">{{ 'lbl.BirthDate'|trans|ucfirst }}</label>
              <div class="row g-2">
                <div class="col-auto">
                  {% form_field day %}
                </div>
                <div class="col-auto">
                  {% form_field month %}
                </div>
                <div class="col-auto">
                  {% form_field year %}
                </div>
              </div>
              {% form_field_error year %}
            </div>
            <div class="mb-4">
              <label for="city" class="form-label">{{ 'lbl.City'|trans|ucfirst }}</label>
              {% form_field city %} {% form_field_error city %}
            </div>
            <div class="mb-4">
              <label for="country" class="form-label">{{ 'lbl.Country'|trans|ucfirst }}</label>
              {% form_field country %} {% form_field_error country %}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="row fork-module-content">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header">
            <h2>
              <label for="about">
                {{ 'lbl.About'|trans|ucfirst }}
              </label>
            </h2>
          </div>
          <div class="card-body">
            {% form_field about %}
          </div>
          {% if txtAboutError %}
            <div class="card-footer">
              {% form_field_error about %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="row fork-module-actions">
      <div class="col-md-12">
        <div class="btn-toolbar">
          <div class="btn-group" role="group">
            {{ macro.buttonIcon(geturl('Index'), 'times', 'lbl.Cancel'|trans|ucfirst) }}
          </div>
          <div class="btn-group float-end" role="group">
            {{ macro.buttonIcon('', 'plus-square', 'lbl.Add'|trans|ucfirst, 'btn-primary', { "type":"submit", "id":"addButton", "name":"add" }) }}
          </div>
        </div>
      </div>
    </div>
  {% endform %}
{% endblock %}
