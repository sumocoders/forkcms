<!DOCTYPE html>
<html lang="{{ FRONTEND_LANGUAGE }}">
<head>
  {# Meta #}
  {% block meta %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="Fork CMS" />
    {{ meta|raw }}
    {{ metaCustom|raw }}
  {% endblock %}

  {% block pageTitle %}
    <title>{{ pageTitle }}</title>
  {% endblock %}

  {# Stylesheets #}
  {% block stylesheets %}
    {% for css in cssFiles %}
      <link rel="stylesheet" href="{{ css }}" />
    {% endfor %}
  {% endblock %}

  {# humans.txt, see http://humanstxt.org #}
  <link rel="author" href="/humans.txt" />

  {% block icons %}
    <link rel="icon" href="{{ THEME_URL }}/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="{{ THEME_URL }}/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ THEME_URL }}/apple-touch-icon.png">
    <link rel="manifest" href="{{ THEME_URL }}/site.webmanifest">
  {% endblock %}

  {% if debug %}
    <script src="http://localhost:35729/livereload.js?snipver=1"></script>
  {% endif %}

  {# Site wide HTML #}
  {% block htmlHeader %}
    {{ siteHTMLHead|raw }}
  {% endblock %}

  {# Extra stuff you want to put in the header #}
  {% block extraHeadScripts %}

  {% endblock %}
</head>
<body class="{{ FRONTEND_LANGUAGE }}" itemscope itemtype="http://schema.org/WebPage">
{# Site wide HTML just after body tag #}
{{ siteHTMLStartOfBody|raw }}

  <div id="root">
    {% import 'Core/Layout/Templates/Alerts.html.twig' as alerts %}

    {% block notifications %}
      {% include 'Core/Layout/Templates/Notifications.html.twig' %}
    {% endblock %}

    {% block navigation %}
      {% include 'Core/Layout/Templates/Navbar.html.twig' %}
    {% endblock %}

    {# Main content #}
    <main id="main">
      {% block main %}

      {% endblock %}
    </main>
  </div>

  {% block footer %}
    {% include 'Core/Layout/Templates/Footer.html.twig' %}
  {% endblock %}

  {% block privacyConsentDialog %}
    {% include "Core/Layout/Templates/PrivacyConsentDialog.html.twig" %}
  {% endblock %}

  {% block searchModal %}
    {% include "Core/Layout/Templates/SearchModal.html.twig" %}
  {% endblock %}

  {# Site wide HTML #}
  {% block htmlFooter %}
    {{ siteHTMLEndOfBody|raw }}
  {% endblock %}

  {% block footerScripts %}
  {# General Javascript #}
    {% for jsFile in jsFiles %}
      <script src="{{ jsFile|raw }}"></script>
    {% endfor %}
  {% endblock %}

</body>
</html>
