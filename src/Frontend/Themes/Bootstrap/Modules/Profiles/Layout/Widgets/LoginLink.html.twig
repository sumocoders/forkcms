{#
  variables that are available:
  - {{ isLoggedIn }}
  - {{ profile }}: only available when logged in
#}

<div class="container">
  <div class="row">
    <div class="col-12">
      {% if isLoggedIn %}
        <div class="dropdown">
          <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="profile-logged-in">
            {# one flex item, so the inline-flex toggle keeps the space before the link #}
            <span>{{ 'msg.ProfilesLoggedInAs'|trans|format(profile.display_name|e, profile.url.dashboard)|raw }}</span>
          </button>
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="profile-logged-in">
            <a href="{{ profile.url.settings }}" class="dropdown-item">{{ 'lbl.Settings'|trans|ucfirst }}</a>
            <a href="{{ geturlforblock('Profiles', 'Logout') }}" class="dropdown-item">{{ 'lbl.Logout'|trans|ucfirst }}</a>
          </div>
        </div>
      {% else %}
        <a href="{{ geturlforblock('Profiles', 'Login') }}?queryString={{ geturlforblock('Profiles') }}">{{ 'lbl.Login'|trans|ucfirst }}</a>
      {% endif %}
    </div>
  </div>
</div>
